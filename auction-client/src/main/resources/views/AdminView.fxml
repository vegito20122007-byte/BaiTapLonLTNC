<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="1050.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controllers.AdminController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <padding>
                  <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
               </padding>
               <children>
                  <Label text="TRANG QUẢN TRỊ VIÊN (ADMIN DASHBOARD)">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="Quản trị viên:" textFill="#555555" />
                  <Label fx:id="lblAdminName" text="admin">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Separator orientation="VERTICAL" />
                  <Button onAction="#handleOpenHistory" text="Lịch sử đấu giá" />
                  <Separator orientation="VERTICAL" />
                  <Button onAction="#handleLogout" text="Đăng xuất" />
               </children>
            </HBox>
            <Separator />
         </children>
      </VBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab text="Quản lý Người Dùng">
             <content>
                <VBox spacing="10.0">
                   <padding>
                      <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                   </padding>
                   <children>
                      <HBox alignment="CENTER_LEFT" spacing="10.0">
                         <children>
                            <Label text="Lọc theo vai trò:" />
                            <ComboBox fx:id="cbFilterRole" prefWidth="130.0" />
                            <TextField fx:id="txtSearchUser" prefWidth="220.0" promptText="Tìm theo username..." />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleRefreshUsers" text="Tải lại danh sách" />
                            <Button onAction="#handleDeleteUser" text="Xóa tài khoản" />
                         </children>
                      </HBox>
                      <TableView fx:id="userTableView" VBox.vgrow="ALWAYS">
                         <columns>
                            <TableColumn fx:id="colUserId" prefWidth="80.0" text="Mã User" />
                            <TableColumn fx:id="colUsername" prefWidth="250.0" text="Tên đăng nhập (Username)" />
                            <TableColumn fx:id="colRole" prefWidth="150.0" text="Vai trò (Role)" />
                            <TableColumn fx:id="colBalance" prefWidth="200.0" text="Số dư ví" />
                         </columns>
                         <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                         </columnResizePolicy>
                      </TableView>
                   </children>
                </VBox>
             </content>
          </Tab>
          <Tab text="Quản lý Phiên Đấu Giá">
             <content>
                <VBox spacing="10.0">
                   <padding>
                      <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                   </padding>
                   <children>
                      <HBox alignment="CENTER_LEFT" spacing="10.0">
                         <children>
                            <Label text="Lọc trạng thái:" />
                            <ComboBox fx:id="cbFilterStatus" prefWidth="140.0" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleCancelAuction" text="Hủy phiên vi phạm" />
                            <Button onAction="#handleRefreshAuctions" text="Tải lại danh sách" />
                         </children>
                      </HBox>
                      <TableView fx:id="auctionTableView" VBox.vgrow="ALWAYS">
                         <columns>
                            <TableColumn fx:id="colAuctionId" prefWidth="60.0" text="Mã" />
                            <TableColumn fx:id="colAuctionName" prefWidth="200.0" text="Tên phiên / Sản phẩm" />
                            <TableColumn fx:id="colAuctionCategory" prefWidth="100.0" text="Danh mục" />
                            <TableColumn fx:id="colAuctionSeller" prefWidth="120.0" text="Người bán" />
                            <TableColumn fx:id="colAuctionStartingPrice" prefWidth="120.0" text="Giá khởi điểm" />
                            <TableColumn fx:id="colAuctionCurrentPrice" prefWidth="120.0" text="Giá cao nhất" />
                            <TableColumn fx:id="colAuctionStatus" prefWidth="100.0" text="Trạng thái" />
                            <TableColumn fx:id="colAuctionEndTime" prefWidth="140.0" text="Thời gian kết thúc" />
                         </columns>
                         <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                         </columnResizePolicy>
                      </TableView>
                   </children>
                </VBox>
             </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
   <bottom>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <Separator />
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <padding>
                  <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
               </padding>
               <children>
                  <Label fx:id="lblMessage" wrapText="true" HBox.hgrow="ALWAYS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblStats" text="Thống kê: 0 Người dùng | 0 Phiên" textFill="#666666">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
