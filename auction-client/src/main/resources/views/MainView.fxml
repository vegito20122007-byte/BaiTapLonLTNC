<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controllers.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20.0" style="-fx-background-color: #1a73e8; -fx-padding: 0 25;">
            <children>
                <Label text="HỆ THỐNG ĐẤU GIÁ TRỰC TUYẾN" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Label fx:id="lblWelcome" text="Xin chào, Bidder!" textFill="WHITE">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>
                <Button onAction="#handleOpenAuctionRoom" style="-fx-background-color: #fbbc04; -fx-text-fill: #202124; -fx-font-weight: bold; -fx-cursor: hand;" text="⚡ Phòng đấu giá mẫu" />
                <Button onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 4; -fx-cursor: hand;" text="Đăng xuất" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtSearch" prefHeight="38.0" prefWidth="350.0" promptText="🔍 Tìm kiếm sản phẩm đấu giá..." style="-fx-background-radius: 6;" />
                        <ComboBox fx:id="cbCategory" prefHeight="38.0" prefWidth="180.0" style="-fx-background-radius: 6;" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblActiveCount" text="Đang tải dữ liệu..." textFill="#5f6368">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <GridPane fx:id="gridAuctions" hgap="20.0" vgap="20.0">
                            <padding>
                                <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                            </padding>
                        </GridPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>