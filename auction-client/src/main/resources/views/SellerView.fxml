<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controllers.SellerController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <padding>
                  <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
               </padding>
               <children>
                  <Label text="KÊNH NGƯỜI BÁN (SELLER)">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="Người bán:" textFill="#555555" />
                  <Label fx:id="lblSellerName" text="seller_user">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Separator orientation="VERTICAL" />
                  <Label text="Số dư:" textFill="#555555" />
                  <Label fx:id="lblBalance" text="0.0 VNĐ" textFill="#2e7d32">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Separator orientation="VERTICAL" />
                  <Button onAction="#handleOpenHistory" text="Lịch sử đấu giá" />
                  <Separator orientation="VERTICAL" />
                  <Button onAction="#handleLogout" text="Đăng xuất" />
               </children>
            </HBox>
            <Separator />
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="10.0" top="15.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="DANH SÁCH PHIÊN ĐẤU GIÁ CỦA BẠN">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#loadData" text="Tải lại danh sách" />
               </children>
            </HBox>
            <TableView fx:id="auctionTableView" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="60.0" text="Mã" />
                  <TableColumn fx:id="colName" prefWidth="180.0" text="Tên phiên / Sản phẩm" />
                  <TableColumn fx:id="colCategory" prefWidth="100.0" text="Danh mục" />
                  <TableColumn fx:id="colStartingPrice" prefWidth="110.0" text="Giá khởi điểm" />
                  <TableColumn fx:id="colMaxBid" prefWidth="110.0" text="Giá cao nhất" />
                  <TableColumn fx:id="colStatus" prefWidth="90.0" text="Trạng thái" />
                  <TableColumn fx:id="colEndTime" prefWidth="140.0" text="Thời gian kết thúc" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>
   <right>
      <VBox fx:id="formPane" maxWidth="330.0" minWidth="310.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="10.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label text="QUẢN LÝ PHIÊN ĐẤU GIÁ">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Separator />
            <VBox spacing="3.0">
               <children>
                  <Label text="Tên phiên / sản phẩm:" />
                  <TextField fx:id="txtName" promptText="Nhập tên sản phẩm..." />
               </children>
            </VBox>
            <VBox spacing="3.0">
               <children>
                  <Label text="Danh mục:" />
                  <ComboBox fx:id="cbCategory" maxWidth="1.7976931348623157E308" promptText="Chọn danh mục..." />
               </children>
            </VBox>
            <VBox spacing="3.0">
               <children>
                  <Label text="Mô tả sản phẩm:" />
                  <TextField fx:id="txtDescription" promptText="Mô tả ngắn gọn về sản phẩm..." />
               </children>
            </VBox>
            <HBox spacing="10.0">
               <children>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Giá khởi điểm:" />
                        <TextField fx:id="txtStartingPrice" promptText="VNĐ" />
                     </children>
                  </VBox>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Giá sàn (Reserve):" />
                        <TextField fx:id="txtReservePrice" promptText="VNĐ" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox spacing="3.0">
               <children>
                  <Label text="Thời lượng phiên (phút):" />
                  <TextField fx:id="txtDurationMinutes" promptText="Ví dụ: 60 (phút)" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Ảnh sản phẩm:" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Button onAction="#handleSelectImage" text="Chọn ảnh..." />
                        <ImageView fx:id="imgPreview" fitHeight="60.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Label fx:id="lblMessage" wrapText="true">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Separator />
            <VBox spacing="8.0">
               <children>
                  <Button defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#handleAddAuction" prefHeight="32.0" text="Tạo phiên đấu giá mới">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  <HBox spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" onAction="#handleUpdateAuction" prefHeight="30.0" text="Cập nhật" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" onAction="#handleDeleteAuction" prefHeight="30.0" text="Xóa phiên" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <Button maxWidth="1.7976931348623157E308" onAction="#handleClearForm" text="Làm mới form" />
               </children>
            </VBox>
         </children>
      </VBox>
   </right>
</BorderPane>
